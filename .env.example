# Nodemailer / SMTP Configuration Example
# Copy this file to .env and fill in your actual SMTP credentials

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aniketsuraj8@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Recipient Email
CONTACT_RECEIVER_EMAIL=aniketsuraj8@gmail.com

# Google Apps Script Webhook URL for Google Sheet Auto-Sync
GOOGLE_SHEET_WEBHOOK_URL=your_google_apps_script_web_app_url_here